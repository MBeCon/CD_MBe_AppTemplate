# Vorlage für die lokale .env – kopieren nach .env und Werte anpassen.
# Die .env selbst wird NIE committet (steht in .gitignore).

# Zufälligen Wert erzeugen: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=bitte-ersetzen

APP_ENV=development
LOG_LEVEL=DEBUG

# Lokal ohne HTTPS auf false, in Produktion true (Default)
SESSION_COOKIE_SECURE=false
