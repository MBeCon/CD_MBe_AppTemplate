{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_bash.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/ruff_on_edit.py\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "te-cd-qs@CD_te_skills": true
  },
  "extraKnownMarketplaces": {
    "CD_te_skills": {
      "source": {
        "source": "git",
        "url": "https://gitlab.technosert.com/datascience/core/applications/CD_te_skills.git"
      },
      "autoUpdate": true
    }
  }
}
